    "@temporalio/workflow": "^1.23.0",
    "nanoid": "^6.0.1"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.0",
    "@types/node": "^22.9.0",
    "prettier": "^3.4.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.6.0"
  }
